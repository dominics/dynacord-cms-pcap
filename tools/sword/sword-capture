#!/usr/bin/env bash
# Capture the Dynacord's USB traffic on sword while play.py runs, then fetch it
# into captures/ as an .xz: tools/sword/sword-capture RATE PATTERN
#
# Assumes the mixer is device 12 on \\.\USBPcap1; check with
# USBPcapCMD.exe --extcap-interface \\.\USBPcap1 --extcap-config
set -euo pipefail
D=$(cd "$(dirname "$0")" && pwd)
OUT=$D/../../captures
rate=$1 pattern=$2 name="cms-${pattern}-${rate}"
scp -O -q -o LogLevel=ERROR -P 11122 "$D/play.py" Dominic@192.168.1.20:ozzy-re/play.py
ps=$(mktemp -t sword-capture).ps1
cat > "$ps" <<PS
\$ProgressPreference = 'SilentlyContinue'
\$env:SD_ENABLE_ASIO = '1'
\$out = "C:\Users\Dominic\ozzy-re\\$name.pcap"
Remove-Item \$out -ErrorAction SilentlyContinue
\$cap = Start-Process -PassThru -WindowStyle Hidden 'C:\Program Files\USBPcap\USBPcapCMD.exe' -ArgumentList '-d','\\\\.\USBPcap1','--devices','12','-o',\$out
Start-Sleep -Seconds 1
py C:\Users\Dominic\ozzy-re\play.py $rate $pattern 2>&1 | ForEach-Object { "\$_" }
Start-Sleep -Milliseconds 500
Stop-Process -Id \$cap.Id
Start-Sleep -Milliseconds 500
Get-Item \$out | ForEach-Object { "\$(\$_.Name) \$(\$_.Length) bytes" }
PS
"$D/sword-ps" "$ps"
rm -f "$ps"
mkdir -p "$OUT"
scp -O -q -o LogLevel=ERROR -P 11122 "Dominic@192.168.1.20:ozzy-re/$name.pcap" "$OUT/"
xz -9 -T0 -f "$OUT/$name.pcap"
ls -la "$OUT/$name.pcap.xz"
